---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <svg width="24" height="24" viewBox="0 0 64 64" aria-hidden="true">
        <circle cx="32" cy="32" r="18" fill="none" stroke="#4f9cf9" stroke-width="2.5"/>
        <path d="M32 14 L32 32 L46 40" fill="none" stroke="#4f9cf9" stroke-width="2.5" stroke-linecap="round"/>
        <circle cx="32" cy="32" r="3.5" fill="#4f9cf9"/>
      </svg>
      <span>Determinisma Komputado</span>
    </div>
    <p class="footer-tagline">Fully deterministic and verifiable AI.</p>
    <p class="footer-copy">© {year} Determinisma Komputado. Built with Astro, hosted on Cloudflare.</p>
  </div>
</footer>

<style>
  .site-footer {
    padding: 48px 0;
    border-top: 1px solid var(--border);
    background: var(--bg-elev);
  }
  .footer-inner {
    text-align: center;
  }
  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    font-weight: 600;
    margin-bottom: 8px;
  }
  .footer-tagline {
    color: var(--text-dim);
    font-size: 0.92rem;
    margin-bottom: 16px;
  }
  .footer-copy {
    color: #5a6b8c;
    font-size: 0.82rem;
  }
</style>
