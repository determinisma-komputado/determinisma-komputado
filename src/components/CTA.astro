<section id="contact" class="cta-section">
  <div class="container">
    <div class="cta-box">
      <span class="section-tag">Get started</span>
      <h2>Bring determinism to your AI pipeline</h2>
      <p>
        Whether you're building safety-critical systems, regulatory compliance
        tools, or simply want AI you can audit — Determinisma Komputado gives
        you reproducibility by construction.
      </p>
      <div class="cta-actions">
        <a href="mailto:office@determinismakomputado.org" class="btn btn-primary">Get in touch</a>
        <a href="#principles" class="btn btn-ghost">Read the principles</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-section {
    padding: 80px 0 100px;
  }

  .cta-box {
    text-align: center;
    max-width: 700px;
    margin: 0 auto;
    padding: 56px 32px;
    background: linear-gradient(180deg, rgba(18, 29, 51, 0.95), rgba(9, 15, 24, 0.94));
    border: 1px solid var(--border);
    border-radius: 22px;
    box-shadow: 0 20px 48px rgba(1, 4, 10, 0.25);
  }

  .cta-box h2 {
    font-size: clamp(1.8rem, 3.8vw, 2.6rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.15;
    margin-bottom: 16px;
  }

  .cta-box p {
    color: var(--text-dim);
    font-size: 1.05rem;
    margin-bottom: 30px;
  }

  .cta-actions {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 28px;
    border-radius: 12px;
    font-weight: 700;
    font-size: 0.96rem;
    transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }

  .btn:hover {
    text-decoration: none;
    transform: translateY(-1px);
  }

  .btn-primary {
    background: linear-gradient(135deg, var(--accent) 0%, var(--accent-strong) 100%);
    color: #fff;
    box-shadow: 0 14px 28px rgba(61, 126, 246, 0.28);
  }

  .btn-ghost {
    color: var(--text-dim);
    border: 1px solid var(--border);
    background: rgba(16, 24, 37, 0.8);
  }

  .btn-ghost:hover {
    color: var(--text);
    border-color: var(--border-strong);
  }
</style>
