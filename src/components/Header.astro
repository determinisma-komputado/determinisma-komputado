---
const title = "Determinisma Komputado";
const description = "Fully deterministic and verifiable AI — every inference reproducible, every output auditable.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --bg: #070b14;
    --bg-elev: #0d1525;
    --bg-card: #121d33;
    --bg-soft: rgba(18, 29, 51, 0.72);
    --border: rgba(148, 163, 184, 0.18);
    --border-strong: rgba(79, 156, 249, 0.42);
    --text: #edf5ff;
    --text-dim: #a4b3cd;
    --text-subtle: #7d90b3;
    --accent: #69a8ff;
    --accent-strong: #3d7ef6;
    --accent-dim: #1e4c9a;
    --green: #4fe3a1;
    --green-soft: rgba(79, 227, 161, 0.16);
    --shadow: rgba(5, 10, 18, 0.55);
    --max-w: 1180px;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  html {
    scroll-behavior: smooth;
    background: var(--bg);
  }

  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    background:
      radial-gradient(circle at top, rgba(78, 131, 255, 0.18), transparent 35%),
      linear-gradient(180deg, #070b14 0%, #090f1a 100%);
    color: var(--text);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  a {
    color: var(--accent);
    text-decoration: none;
    transition: color 0.2s ease, opacity 0.2s ease;
  }

  a:hover { text-decoration: underline; }

  img, svg { display: block; max-width: 100%; }

  .container {
    width: min(var(--max-w), calc(100% - 32px));
    margin: 0 auto;
  }

  .section-tag {
    display: inline-block;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 14px;
  }

  .section-head {
    text-align: center;
    max-width: 620px;
    margin: 0 auto 52px;
  }

  .section-head h2 {
    font-size: clamp(1.9rem, 4vw, 2.9rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.1;
    margin-bottom: 14px;
  }

  .section-sub {
    color: var(--text-dim);
    font-size: 1.04rem;
  }

  ::selection {
    background: rgba(105, 168, 255, 0.3);
    color: #fff;
  }
</style>
